{
  "name": "@shop/mini",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "The WeChat mini-program storefront (Taro 4 + React 18). The H5 build is for e2e and DIY preview only.",
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch --no-check",
    "dev:h5": "taro build --type h5 --watch --no-check",
    "build:weapp": "taro build --type weapp --no-check && node scripts/size-report.mjs",
    "build:h5": "taro build --type h5 --no-check",
    "build:h5:mp-emulation": "TARO_APP_PLATFORM_EMULATION=mp taro build --type h5 --no-check",
    "build": "pnpm run build:weapp && pnpm run build:h5",
    "size": "node scripts/size-report.mjs",
    "tab-icons": "node scripts/tab-icons.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.weapp.json",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@shop/api-client": "workspace:*",
    "@shop/contracts": "workspace:*",
    "@shop/storefront-blocks": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@shop/config": "workspace:*",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "^8.18.0",
    "babel-preset-taro": "4.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.2",
    "sass": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "webpack": "5.91.0"
  }
}
