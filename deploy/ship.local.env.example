# Where `deploy/ship.sh` releases to. Copy to `ship.local.env` (gitignored) and
# fill in. A variable set in the environment wins over this file.
#
#   cp deploy/ship.local.env.example deploy/ship.local.env

# The SSH destination of the host, as `ssh` would take it: `user@host`, or a
# `Host` alias from ~/.ssh/config. `local` runs the host side on this machine.
SHIP_HOST=user@shop-host.example

# The release directory on that host: the one holding `shop`, `compose.yml`
# and `deployment.env`.
SHIP_DIR=/path/to/the/release/directory
