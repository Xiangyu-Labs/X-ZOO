    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "testcontainers": "^12.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@shop/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^10.11.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
