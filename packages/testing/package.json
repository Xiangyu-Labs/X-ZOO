{
  "name": "@shop/testing",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./global-setup": "./src/harness/global-setup.ts",
    "./mock-server": "./src/mock-server/index.ts",
    "./wechat": "./src/wechat/index.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "shop-mock": "./src/mock-server/cli.ts"
  },
  "scripts": {
    "mock": "tsx src/mock-server/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit --project web-server-unit",
    "test:int": "vitest run --project int --project web-server-int"
  },
  "dependencies": {
    "@shop/contracts": "workspace:*",
    "@shop/core": "workspace:*",
    "@shop/db": "workspace:*",
