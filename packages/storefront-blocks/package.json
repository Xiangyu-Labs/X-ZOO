{
  "name": "@shop/storefront-blocks",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./dom": "./src/dom/index.tsx",
    "./fixtures": "./src/fixtures.ts",
    "./admin": {
      "types": "./src/admin.ts",
      "default": "./dist/admin.js"
    },
    "./admin.css": "./dist/admin.css",
    "./admin-css": {
      "types": "./src/admin-css.ts",
      "default": "./dist/admin-css.js"
    }
  },
  "scripts": {
    "gen": "tsx scripts/gen-css-types.ts && tsx scripts/build.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit --project unit-react18",
    "fidelity": "tsx fidelity/run.ts"
  },
  "dependencies": {
    "@shop/contracts": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shop/config": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-18": "npm:@types/react@18.3.31",
    "@types/react-dom": "^19.3.0",
    "@types/react-dom-18": "npm:@types/react-dom@18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-18": "npm:react@18.3.1",
    "react-dom": "^19.3.0",
    "react-dom-18": "npm:react-dom@18.3.1",
    "sass": "~1.104.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
